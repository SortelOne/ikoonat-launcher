diff --git a/npc_filedata.h b/npc_filedata.h
index 27b0f04..902b40e 100644
--- a/npc_filedata.h
+++ b/npc_filedata.h
@@ -261,6 +261,113 @@ struct NPCConfigFile
     //! At player-set resolutions, should the NPC still activate based on the content's default resolution?
     bool usedefaultcam = false;
 
+/*
+ * TheXTech-Lua extended traits (each value is applied only when its en_ flag is set)
+ */
+    bool en_gfxsplitheight = false;
+    //! Height of one split part of the sprite
+    uint32_t gfxsplitheight = 0;
+
+    bool en_nolava = false;
+    //! Immune to lava
+    bool nolava = false;
+
+    bool en_noleaf = false;
+    //! Immune to leaf/tanooki tail
+    bool noleaf = false;
+
+    bool en_noblockhit = false;
+    //! Immune to damage from block hits
+    bool noblockhit = false;
+
+    bool en_spinjump = false;
+    //! Allows spin jump stomp
+    bool spinjump = false;
+
+    bool en_spinjumphurt = false;
+    //! Hurts player on spin jump
+    bool spinjumphurt = false;
+
+    bool en_waterjumphurt = false;
+    //! Hurts player on water jump
+    bool waterjumphurt = false;
+
+    bool en_yoshihurt = false;
+    //! Hurts yoshi-rider on stomp
+    bool yoshihurt = false;
+
+    bool en_instantkill = false;
+    //! Instant kill on contact
+    bool instantkill = false;
+
+    bool en_immortal = false;
+    //! Cannot be killed
+    bool immortal = false;
+
+    bool en_groundpoundbreak = false;
+    //! Ground pound breaks this NPC
+    bool groundpoundbreak = false;
+
+    bool en_megabreak = false;
+    //! Mega form breaks this NPC
+    bool megabreak = false;
+
+    bool en_turboweak = false;
+    //! Turbo dash deals shell damage
+    bool turboweak = false;
+
+    bool en_nosectionwrap = false;
+    //! Ignores section wrap
+    bool nosectionwrap = false;
+
+    bool en_npcblockside = false;
+    //! Blocks NPCs at side
+    bool npcblockside = false;
+
+    bool en_float = false;
+    //! Floats on water surface ("float" key)
+    bool float_npc = false;
+
+    bool en_nopiercingdmg = false;
+    //! Immune to piercing damage
+    bool nopiercingdmg = false;
+
+    bool en_pushable = false;
+    //! Can be pushed by player
+    bool pushable = false;
+
+    bool en_stackable = false;
+    //! Stays still when on another stackable NPC
+    bool stackable = false;
+
+    bool en_canmeltblock = false;
+    //! Can melt ice blocks on contact
+    bool canmeltblock = false;
+
+    bool en_wingsforever = false;
+    //! Wings don't disappear when hurt
+    bool wingsforever = false;
+
+    bool en_nonpccollision = false;
+    //! Skip NPC-NPC collision
+    bool nonpccollision = false;
+
+    bool en_frozentime = false;
+    //! Freeze duration in frames (-1 = never)
+    int32_t frozentime = 0;
+
+    bool en_yoshitransform = false;
+    //! NPC ID after yoshi swallow (0 = no transform)
+    uint32_t yoshitransform = 0;
+
+    bool en_frozentransform = false;
+    //! NPC ID after frozen (0 = no transform)
+    uint32_t frozentransform = 0;
+
+    bool en_jumptransform = false;
+    //! NPC ID after jump stomp (0 = no transform)
+    uint32_t jumptransform = 0;
+
 };
 
 #endif // NPC_FILEDATA_H
